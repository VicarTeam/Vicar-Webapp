PORT=6660

MONGO_URI=mongodb://localhost:27017/vicar
# MONGO_DB=            # optional; sonst aus MONGO_URI abgeleitet

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:6660

JWT_SECRET=

CDN_DIR=./cdn-data

# DEV_MODE=true        # aktiviert /auth/login/dev (Fake-Login ohne Discord)

# --- DB-Modus (Mongo -> Postgres Übergang) ---
# mongo_only | split | dual_write_mongo_primary | dual_write_pg_primary | pg_only
#   split = alte Chars auf Mongo, neue auf Postgres, Migration on-demand (empfohlen)
DB_MODE=mongo_only
# POSTGRES_URL nötig, sobald DB_MODE != mongo_only:
# POSTGRES_URL=postgres://user:pass@localhost:5432/vicar?sslmode=disable
